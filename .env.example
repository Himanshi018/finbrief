# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# News source: rss (default; Indian finance RSS feeds, no key needed) | newsapi (local dev only:
# the free plan forbids production use and delays articles by 24h)
NEWS_SOURCE=rss

# NewsAPI (https://newsapi.org), only needed when NEWS_SOURCE=newsapi
NEWS_API_KEY=your-newsapi-key

# OpenAI-compatible API (OpenAI, Groq, Together, etc.)
# Groq (default): OPENAI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=openai/gpt-oss-120b
# OpenAI:         OPENAI_BASE_URL=https://api.openai.com/v1        AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# Ingestion (protect cron + manual ingest routes)
CRON_SECRET=generate-a-long-random-string

# Site URL (optional, for metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
